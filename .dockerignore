# Git files
.git
.gitignore
.github

# IDE files
.idea
.vscode
*.iml
*.iws
*.ipr

# Build files (except the final JAR)
build/classes
build/generated
build/reports
build/test-results
build/tmp
build/resources
build/spotless-clean
build/spotless-lints

# Gradle files (keep gradle/wrapper/* for Dockerfile.dev; production Dockerfile does not use gradle)
.gradle

# Test files (Dockerfile.dev needs src/ for build; production Dockerfile only uses build/libs/*.jar)
*.test.*

# Documentation
README.md
HELP.md
LICENSE

# Logs
*.log

# Temporary files
*.tmp
*.bak
*.swp
*~
