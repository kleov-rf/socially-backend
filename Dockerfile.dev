# Multi-stage Dockerfile for local development (builds JAR then runs it)
# Matches multi-module layout: app (Spring Boot) + donation (domain, application, infrastructure)
FROM eclipse-temurin:25-jdk-alpine AS builder

WORKDIR /app

# Copy Gradle wrapper and root build config
COPY gradle gradle
COPY gradlew build.gradle.kts settings.gradle.kts ./

# Copy all subprojects (app + donation + commons modules)
COPY app app
COPY donation donation
COPY commons commons

# Build the application (no daemon, produce boot JAR from app module)
RUN ./gradlew :app:bootJar --no-daemon -x test

# Runtime stage (matches production Dockerfile)
FROM eclipse-temurin:25-jre-alpine

WORKDIR /app

RUN apk add --no-cache wget && \
    addgroup -S spring && adduser -S spring -G spring

# Boot JAR is produced by the app module
COPY --from=builder /app/app/build/libs/*.jar app.jar

RUN chown spring:spring app.jar

USER spring:spring

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-Djava.security.egd=file:/dev/./urandom", "-jar", "app.jar"]
